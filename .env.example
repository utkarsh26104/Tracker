# Groq (free tier - no card required, https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_SUPERVISOR_MODEL=openai/gpt-oss-120b
GROQ_WRITER_MODEL=openai/gpt-oss-120b

# Tavily search (free tier: 1000 credits/month, no card required)
TAVILY_API_KEY=

# Protects /tracker/* endpoints. Leave blank for local dev (no auth
# enforced). Set a random value before deploying publicly, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Postgres (LangGraph checkpointer) - Neon free tier or local Docker
DATABASE_URL=postgresql://tracker:tracker@localhost:5432/tracker

# ChromaDB (embedded, local persistence)
CHROMA_PERSIST_DIR=./data/chroma

# FinancialBERT models (local HuggingFace, no API cost)
FINBERT_EMBED_MODEL=yiyanghkust/finbert-tone
FINBERT_SENTIMENT_MODEL=ProsusAI/finbert

APP_ENV=dev
LOG_LEVEL=INFO

# Optional LLM tracing (latency/token usage/errors are always logged as
# structured JSON regardless of these - see app/observability.py). Leave
# blank to skip Langfuse entirely; get free keys at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
